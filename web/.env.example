# Neon Postgres (optional — demo JSON in data/ works when this is unset)
# Pooled connection string from the Neon dashboard. The host contains "-pooler".
# Server-only. Do not prefix with NEXT_PUBLIC_.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Admin UI password (cookie auth)
VYPRVA_ADMIN_PASSWORD=vyprava

# Optional: Paper plugin HTTP API (for /api/sync)
VYPRVA_PLUGIN_API_URL=http://127.0.0.1:8765
VYPRVA_PLUGIN_API_TOKEN=
NEXT_PUBLIC_VYPRVA_API_URL=

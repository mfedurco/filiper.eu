# Pooled Neon connection for the Next.js app. Never commit a real value.
DATABASE_URL=

# Shared admin password. If this is missing, /admin stays locked and does not write.
ADMIN_SECRET=

# Optional leftover plugin HTTP sync. Prefer ADMIN_SECRET above.
VYPRVA_PLUGIN_API_URL=http://127.0.0.1:8765
VYPRVA_PLUGIN_API_TOKEN=

# Pooled Neon connection for the Next.js app. Never commit a real value.
DATABASE_URL=

# Canonical public origin. OAuth redirects and write-origin checks never trust forwarded host headers.
APP_ORIGIN=https://vyprava.filiper.eu

# Shared secret used once, by a signed-in Google account, to become the first správca.
# It is not the admin login. If this is missing, the first správca cannot be saved.
ADMIN_SECRET=

# Existing Google OAuth client. Redirect URI: https://vyprava.filiper.eu/api/auth/google/callback
# Leave empty until the client exists. Do not add a second client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Independent random values (at least 32 bytes each). Never reuse application credentials.
RATE_LIMIT_SECRET=
HEALTH_SECRET=
CRON_SECRET=

# Optional: readiness is unhealthy when any keyed server has not contacted the portal in this many minutes.
PLUGIN_SYNC_STALE_MINUTES=5
